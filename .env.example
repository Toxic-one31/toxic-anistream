# ─── Primary API — Self-hosted HiAnime scraper ────────────────────────────────
# Clone & deploy: https://github.com/itzzzme/anime-api
# or:             https://github.com/yahyaMomin/hianime-API
# Point this at your Railway / Render / VPS deployment.
# Include the /api suffix if the scraper uses it.
VITE_API_URL=https://your-hianime-scraper.railway.app/api

# ─── Fallback API — Self-hosted Consumet (GogoAnime) ─────────────────────────
# Clone & deploy: https://github.com/consumet/api.consumet.org
# Leave blank to disable the GogoAnime fallback entirely.
VITE_CONSUMET_URL=https://your-consumet.railway.app

# ─── M3U8 proxy (for CORS-blocked HLS streams) ───────────────────────────────
VITE_M3U8_PROXY_URL=https://your-m3u8-proxy/m3u8-proxy?url=
VITE_HD_1_PROXY_URL=https://your-hd1-proxy/m3u8-proxy?url=

# ─── Optional: Load-balanced worker URLs (comma-separated) ───────────────────
# Used by qtip and top-search to spread load across multiple scraper instances.
VITE_WORKER_URL=https://worker1.railway.app/api,https://worker2.railway.app/api
